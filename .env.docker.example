APP_URL=http://localhost:8080
APP_PORT=8080
APP_KEY=base64:GANTI_DENGAN_KUNCI_32_BYTE
SESSION_SECURE_COOKIE=false

DB_DATABASE=izinhukum
DB_USERNAME=izinhukum
DB_PASSWORD=ganti-password-kuat
DB_ROOT_PASSWORD=ganti-root-password-kuat

ADMIN_EMAIL=admin@izinhukum.com
ADMIN_PASSWORD=ganti-password-admin-kuat

# Aktifkan hanya pada deployment pertama. Setelah data awal terpasang, ubah menjadi false.
SEED_DATABASE=false
RUN_MIGRATIONS=true

# Isi alamat IP proxy/load balancer yang benar, pisahkan dengan koma.
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailketing.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=izinhukum@gmail.com
MAIL_FROM_NAME=IzinHukum

# V11: queue database. Worker dan scheduler dijalankan Supervisor.
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=300
QUEUE_FAILED_DRIVER=database-uuids

# V11: StarSender. Simpan nilai asli hanya di Environment Variables Coolify.
STARSENDER_ENABLED=false
STARSENDER_BASE_URL=https://api.starsender.online
STARSENDER_ACCOUNT_API_KEY=
STARSENDER_DEFAULT_DEVICE_KEY=
STARSENDER_TRANSACTION_DEVICE_KEY=
STARSENDER_SUPPORT_DEVICE_KEY=
STARSENDER_PARTNER_DEVICE_KEY=
STARSENDER_CAMPAIGN_DEVICE_KEY=

# Buat secret acak minimal 48 karakter. Jangan gunakan nilai contoh ini.
STARSENDER_WEBHOOK_SECRET=GANTI_DENGAN_SECRET_ACAK_PANJANG
# Opsional jika StarSender dapat mengirim custom header X-Webhook-Secret.
STARSENDER_WEBHOOK_HEADER_SECRET=

STARSENDER_TIMEOUT=20
STARSENDER_CONNECT_TIMEOUT=5
STARSENDER_MAX_ATTEMPTS=4
STARSENDER_DEFAULT_DELAY=2
STARSENDER_CAMPAIGN_DAILY_LIMIT=50

# Add-on dan fitur berisiko tetap false sampai diuji.
STARSENDER_ROTATOR_ENABLED=false
STARSENDER_WEBHOOK_PREMIUM_ENABLED=false
STARSENDER_WEBHOOK_MEDIA_ENABLED=false
STARSENDER_WEBHOOK_GROUP_ENABLED=false
STARSENDER_WEBHOOK_RETENTION_DAYS=90
STARSENDER_TECHNICAL_LOG_RETENTION_DAYS=180

# V12 CRM & Document Vault
STARSENDER_MEDIA_ALLOWED_HOSTS=starsender.online
STARSENDER_MEDIA_ARCHIVE_MAX_BYTES=20971520
