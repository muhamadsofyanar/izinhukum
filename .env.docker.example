APP_URL=http://localhost:8080
APP_PORT=8080
APP_KEY=base64:GANTI_DENGAN_KUNCI_32_BYTE
SESSION_SECURE_COOKIE=false

DB_DATABASE=izinhukum
DB_USERNAME=izinhukum
DB_PASSWORD=ganti-password-kuat
DB_ROOT_PASSWORD=ganti-root-password-kuat

ADMIN_EMAIL=admin@izinhukum.com
ADMIN_PASSWORD=ganti-password-admin-kuat

# Aktifkan hanya pada deployment pertama. Setelah data awal terpasang, ubah menjadi false.
SEED_DATABASE=false
RUN_MIGRATIONS=true

# Isi alamat IP proxy/load balancer yang benar, pisahkan dengan koma.
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailketing.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=izinhukum@gmail.com
MAIL_FROM_NAME=IzinHukum

# Notifikasi pesanan baru. Jika kosong, email memakai ADMIN_EMAIL dan WA memakai COMPANY_WHATSAPP.
ORDER_NOTIFICATION_EMAIL_ENABLED=true
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_WHATSAPP_ENABLED=true
ORDER_NOTIFICATION_WHATSAPP=

# Queue database. Worker dan scheduler dijalankan Supervisor.
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=300
QUEUE_FAILED_DRIVER=database-uuids

# StarSender hanya untuk notifikasi WhatsApp satu arah. Tidak ada CRM, inbox, campaign, atau webhook masuk.
STARSENDER_ENABLED=false
STARSENDER_BASE_URL=https://api.starsender.online
STARSENDER_DEFAULT_DEVICE_KEY=
STARSENDER_TRANSACTION_DEVICE_KEY=

STARSENDER_TIMEOUT=20
STARSENDER_CONNECT_TIMEOUT=5
STARSENDER_MAX_ATTEMPTS=4
STARSENDER_DEFAULT_DELAY=2
STARSENDER_TECHNICAL_LOG_RETENTION_DAYS=180
